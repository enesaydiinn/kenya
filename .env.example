# Yerel kurulum: cp .env.example .env.local
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000
# Üretimde PostgreSQL zorunludur. Geliştirme dosya deposunu üretimde açmayın.
DATABASE_URL=
LOCAL_DATA_ENABLED=true
LOCAL_DATA_DIR=.data
# En az 32 rastgele karakter. Üretimde gizli ortam değişkenleri kullanın.
SESSION_SECRET=
RATE_LIMIT_SECRET=
# Yalnız güvenilir Vercel / ters proxy arkasında true yapın.
TRUST_PROXY=false
# Özel önizleme için false. Alan adı ve içerik incelemesi tamamlanınca true.
INDEXING_ENABLED=false
GSC_VERIFICATION=
# Opsiyonel e-posta bildirimleri (yalnız talep ID'si gönderilir).
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
# Sites Worker önizlemesi için derleme betiği tarafından kullanılır.
SITES_ORIGIN=https://kenya-danismanlik.udemyenes.chatgpt.site
