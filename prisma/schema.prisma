generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Lead {
  id String @id @default(cuid())
  name String
  company String
  email String
  phone String
  country String
  service String
  sector String
  message String
  preference String
  locale String @default("tr")
  consentVersion String
  status String @default("Yeni Talep")
  notificationStatus String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Content {
  id String @id
  slug String
  locale String
  type String
  title String
  description String
  body Json
  status String @default("draft")
  seoTitle String?
  seoDescription String?
  image String?
  faqs Json?
  sources Json
  author String @default("Kenya Danışmanlık Editör Ekibi")
  reviewedAt String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([locale, type, slug])
}
model Setting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}
model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role String @default("admin")
  createdAt DateTime @default(now())
}
model Session {
  id String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
